{
  "name": "@hospiman/schema-validator-joi",
  "version": "0.0.6",
  "description": "Hospiman joi schema validator wrapper",
  "homepage": "https://github.com/hospiman/hospiman-schema-validator-joi#readme",
  "license": "MIT",
  "author": "Hospiman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hospiman/hospiman-schema-validator-joi.git"
  },
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "pub": "npm publish",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "joi": "18.2.9",
    "libphonenumber-js": "^1.13.15"
  }
}
